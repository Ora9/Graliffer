[
  {
    "context": "",
    "bindings": {
      "ctrl-a": "ToggleAbout",
      "alt-p": "ToggleCommandPicker",
      "ctrl-q": "Quit"
    }
  },
  {
    "context": "popuped",
    "bindings": {
      "escape": "ClosePopup"

    }
  },
  {
    "context": "command",
    "bindings": {
      "i": "InsertMode"
    }
  },
  {
    "context": "insert",
    "bindings": {
      "escape": "CommandMode"
    }
  },
  {
    "context": "Grid",
    "bindings": {
      "up": "grid::CursorUp",
      "down": "grid::CursorDown",
      "right": "grid::CursorRight",
      "left": "grid::CursorLeft",

      "backspace": "grid::DeletePrevChar",
      "delete": "grid::DeleteNextChar"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "backspace": "picker::DeletePrevChar",
      "delete": "picker::DeleteNextChar",
      "up": "picker::SelectionUp",
      "down": "picker::SelectionDown",
      "right": "picker::CursorRight",
      "left": "picker::CursorLeft",
      "ctrl-backspace": "picker::DeleteTillStart",
      "ctrl-w": "picker::DeleteTillStart"
    }
  }
]
