[
  {
    "context": "",
    "bindings": {
      "ctrl-a": "ToggleAbout",
      "ctrl-p": "ToggleCommandPicker",
      "ctrl-q": "Quit"
    }
  },
  {
    "context": "popup_opened",
    "bindings": {
      "escape": "ClosePopup"

    }
  },
  {
    "context": "command",
    "bindings": {
      "i": "InsertMode"
    }
  },
  {
    "context": "insert",
    "bindings": {
      "escape": "CommandMode"
    }
  }
]
