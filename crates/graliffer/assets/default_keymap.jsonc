[
  {
    "context": "",
    "bindings": {
      "ctrl-a": "ToggleAbout",
      "alt-p": "ToggleCommandPicker",
      "ctrl-q": "Quit"
    }
  },
  {
    "context": "popuped",
    "bindings": {
      "escape": "ClosePopup"

    }
  },
  {
    "context": "command",
    "bindings": {
      "i": "InsertMode"
    }
  },
  {
    "context": "insert",
    "bindings": {
      "escape": "CommandMode"
    }
  },
  {
    "context": "Grid",
    "bindings": {
      "up": "grid::CursorStepUpGrid",
      "down": "grid::CursorStepDownGrid",
      "right": "grid::CursorStepRightCharThenGrid",
      "left": "grid::CursorStepLeftCharThenGrid",

      "alt-up": "grid::CursorStepUpGrid",
      "alt-down": "grid::CursorStepDownGrid",
      "alt-right": "grid::CursorStepRightGrid",
      "alt-left": "grid::CursorStepLeftGrid",

      "ctrl-up": "grid::CursorDashUpCharThenGrid",
      "ctrl-down": "grid::CursorDashDownCharThenGrid",
      "ctrl-right": "grid::CursorDashRightCharThenGrid",
      "ctrl-left": "grid::CursorDashLeftCharThenGrid",

      "tab": "grid::CursorStepRightGrid",
      "enter": "grid::CursorStepDownGrid",

      "backspace": "grid::DeletePrevCharOrStepLeftGrid",
      "ctrl-w": "grid::DeleteTillStart",
      "ctrl-backspace": "grid::DeleteTillStartOrStepLeftGrid",

      "delete": "grid::DeleteNextChar"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "backspace": "picker::DeletePrevChar",
      "delete": "picker::DeleteNextChar",
      "up": "picker::SelectionUp",
      "down": "picker::SelectionDown",
      "right": "picker::CursorRight",
      "left": "picker::CursorLeft",
      "ctrl-backspace": "picker::DeleteTillStart",
      "ctrl-w": "picker::DeleteTillStart"
    }
  }
]
